OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Models are tried in this order.
OPENROUTER_PRIMARY_MODEL=qwen/qwen3-8b:free
OPENROUTER_FALLBACK_MODEL_1=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL_2=llama-3.3-70b-instruct:free
# Optional backward-compatible single-model variable.
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Optional fixed preferred assistant voice.
# If this exact voice is unavailable, the app falls back to automatic
# language-based voice selection or the device default.
TTS_PREFERRED_VOICE_IDENTIFIER=
TTS_PREFERRED_VOICE_NAME=
TTS_PREFERRED_VOICE_LOCALE=
APP_DEBUG=false
APP_LOG_LEVEL=info
